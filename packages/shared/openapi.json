  "components": {
    "schemas": {
      "AudioTrack": {
        "properties": {
          "asset_path": {
            "type": "string",
            "title": "Asset Path"
          },
          "kind": {
            "type": "string",
            "enum": [
              "music",
              "sound-effects",
              "ambience"
            ],
            "title": "Kind"
          },
          "start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Start"
          },
          "trim_start": {
            "type": "number",
            "minimum": 0.0,
            "title": "Trim Start",
            "default": 0
          },
          "duration": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Duration"
          },
          "gain": {
            "type": "number",
            "maximum": 2.0,
            "minimum": 0.0,
            "title": "Gain",
            "default": 0.25
          },
          "fade": {
            "type": "number",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Fade",
            "default": 0.5
          },
          "duck_under_speech": {
            "type": "boolean",
            "title": "Duck Under Speech",
            "default": true
          },
          "license_note": {
            "type": "string",
            "maxLength": 1000,
            "minLength": 3,
            "title": "License Note"
          }
        },
        "type": "object",
        "required": [
          "asset_path",
          "kind",
          "start",
          "duration",
          "license_note"
        ],
        "title": "AudioTrack"
      },
      "Body_reference_projects__project_id__references_post": {
        "properties": {
