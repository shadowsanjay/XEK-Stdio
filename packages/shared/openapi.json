            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Name"
          },
          "visual_description": {
            "type": "string",
            "maxLength": 4000,
            "title": "Visual Description",
            "default": ""
          },
          "costume": {
            "type": "string",
            "title": "Costume",
            "default": ""
          },
          "proportions": {
            "type": "string",
            "title": "Proportions",
            "default": ""
          },
          "facial_features": {
            "type": "string",
            "title": "Facial Features",
            "default": ""
          },
          "movement": {
            "type": "string",
            "title": "Movement",
            "default": ""
          },
          "voice": {
            "type": "string",
            "title": "Voice",
            "default": "A clear, expressive narrator with a low, calm voice."
          },
          "personality": {
            "type": "string",
            "title": "Personality",
            "default": ""
          },
          "visual_style": {
            "type": "string",
            "title": "Visual Style",
            "default": ""
          },
          "canonical_prompt": {
            "type": "string",
            "title": "Canonical Prompt",
            "default": ""
          },
          "negative_prompt": {
            "type": "string",
            "title": "Negative Prompt",
            "default": ""
          },
          "reference_assets": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Reference Assets"
          },
          "seed": {
            "type": "integer",
            "maximum": 9.223372036854776e+18,
            "minimum": 0.0,
            "title": "Seed",
            "default": 42
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "Character"
      },
      "CreateProject": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Name"
          },
          "prompt": {
            "type": "string",
            "maxLength": 40000,
            "minLength": 10,
            "title": "Prompt"
          },
          "duration_minutes": {
            "type": "integer",
            "enum": [
              1,
              3,
              5,
              10,
              15,
              20,
              30
            ],
            "title": "Duration Minutes",
            "default": 1
          },
          "language": {
            "type": "string",
            "enum": [
              "ta",
              "en"
            ],
            "title": "Language",
            "default": "ta"
          },
          "genre": {
            "type": "string",
            "maxLength": 200,
            "title": "Genre",
            "default": "Supernatural horror"
          },
          "style": {
            "type": "string",
            "maxLength": 200,
            "title": "Style",
            "default": "Dark cinematic horror comic"
          },
          "audience": {
            "type": "string",
            "title": "Audience",
            "default": "Adults"
          },
          "pacing": {
            "type": "string",
            "title": "Pacing",
            "default": "Suspenseful"
          },
          "ending": {
            "type": "string",
            "title": "Ending",
            "default": "A frightening reveal"
          },
