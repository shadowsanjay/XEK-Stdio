# Local host profile; generate AUTH_SECRET/ADMIN_PASSWORD with configure_local.py.
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=sqlite:///./data/xek.db
WORKER_MODE=inline
DATA_DIR=data
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT=8192
OLLAMA_MAX_TOKENS=16000
COMFYUI_URL=http://127.0.0.1:8188
IMAGE_WORKFLOW=workflows/flux-schnell-gguf.json
IMAGE_MODEL=flux1-schnell-Q4_0.gguf
IMAGE_TEXT_ENCODER=t5-v1_1-xxl-encoder-Q4_K_M.gguf
IMAGE_CLIP=clip_l.safetensors
IMAGE_VAE=ae.safetensors
VIDEO_WORKFLOW=workflows/video.json
VIDEO_MODEL=wan2.2_ti2v_5B_fp16.safetensors
SPEECH_URL=http://localhost:8001
TTS_MODEL=ai4bharat/indic-parler-tts
TTS_DEVICE=cpu
LOW_MEMORY_MODE=true
WHISPER_MODEL=small
YOUTUBE_PUBLISHING_ENABLED=false
# Set HF_TOKEN through your local environment after approving access; never commit or share it.
