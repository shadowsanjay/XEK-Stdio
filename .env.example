# Generate secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-long-random-password
ADMIN_USERNAME=admin
DATABASE_URL=postgresql+psycopg://xek:xek-local@postgres:5432/xek
REDIS_URL=redis://redis:6379/0
DATA_DIR=/data
WEB_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_CONTEXT=8192
OLLAMA_MAX_TOKENS=16000
COMFYUI_URL=http://host.docker.internal:8188
IMAGE_WORKFLOW=/app/workflows/flux-schnell-gguf.json
VIDEO_WORKFLOW=/app/workflows/video.json
SPEECH_URL=http://host.docker.internal:8001
IMAGE_MODEL=flux1-schnell-Q4_0.gguf
IMAGE_TEXT_ENCODER=t5-v1_1-xxl-encoder-Q4_K_M.gguf
IMAGE_CLIP=clip_l.safetensors
IMAGE_VAE=ae.safetensors
VIDEO_MODEL=wan2.2_ti2v_5B_fp16.safetensors
TTS_MODEL=ai4bharat/indic-parler-tts
TTS_DEVICE=cpu
LOW_MEMORY_MODE=true
WHISPER_MODEL=small
SUBTITLE_FONT=Noto Sans Tamil
FFMPEG=ffmpeg
FFPROBE=ffprobe
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_AUDIT_APPROVED=false
# Set by the channel owner; the app also requires a project-specific approval.
YOUTUBE_PUBLISHING_ENABLED=false
WORKER_MODE=celery
MAX_UPLOAD_MB=20
MODEL_TIMEOUT_SECONDS=1800
